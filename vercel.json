{
  "buildCommand": "npm run build --workspace=Frontend",
  "outputDirectory": "Frontend/dist",
  "rewrites": [
    {
      "source": "/api/:match*.php",
      "destination": "/api/:match*"
    },
    {
      "source": "/((?!api/|assets/|favicon.ico|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
